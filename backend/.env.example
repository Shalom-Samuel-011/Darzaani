# MongoDB Atlas
DB_STRING=mongodb+srv://<username>:<db_password>@<cluster-host>/<database>?retryWrites=true&w=majority
DB_PASSWORD=replace_me

# Application
NODE_ENV=development
PORT=2000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=90d

# Razorpay Test Mode credentials. Keep config.env out of version control.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Create a Razorpay webhook for /api/v1/webhooks/razorpay and copy its secret here.
# Subscribe to payment.authorized, payment.captured, and payment.failed.
RAZORPAY_WEBHOOK_SECRET=replace_me

# Optional: Google sign-in
GOOGLE_CLIENT_ID=

# Optional: password-reset email delivery
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
