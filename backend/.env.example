# Razorpay test or live API credentials. Keep config.env out of version control.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Create a Razorpay webhook for /api/v1/webhooks/razorpay and copy its secret here.
# Subscribe to payment.authorized, payment.captured, and payment.failed.
RAZORPAY_WEBHOOK_SECRET=replace_me
